# CivitasOS Beta-6 external Agent API intake example.
# Copy to .env.beta6.external.local and fill real values. Do not commit local files.

# The provider name is descriptive only; the Beta-6 card intake does not call the provider.
BETA6_EXTERNAL_AGENT_PROVIDER=openai_compatible

# External Agent API endpoint and model. Do not include credentials in the URL.
BETA6_EXTERNAL_AGENT_API_BASE_URL=https://api.deepseek.com
BETA6_EXTERNAL_AGENT_MODEL=REPLACE_WITH_EXTERNAL_AGENT_MODEL

# Secret. This must only exist in .env.beta6.external.local.
BETA6_EXTERNAL_AGENT_API_KEY=REPLACE_WITH_EXTERNAL_AGENT_API_KEY
