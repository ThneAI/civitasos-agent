# ── CivitasOS Agent 配置 ──────────────────────────────────

# 后端节点（多节点逗号分割）
CIVITASOS_URL=http://localhost:8099

# Agent 基本信息
AGENT_NAME=MyAgent
AGENT_CAPABILITIES=general,translation
AGENT_STAKE=100
AGENT_HEARTBEAT=60

# LLM 配置
# 格式: provider:model
# Ollama:    ollama:qwen3:latest
# OpenAI:    openai:gpt-4o
# Anthropic: anthropic:claude-sonnet-4-20250514
AGENT_LLM=ollama:qwen3:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=

# Gateway (接收 webhook 唤醒 + A2A 通信)
# 设为 0 则不启用 Gateway
GATEWAY_PORT=8300

# 身份持久化
AGENT_IDENTITY=data/identity.key

# 公开端点（其他 Agent / CivitasOS 回调用）
# Docker 内部: http://agent:8300
# 外部: http://your-server:8300
AGENT_ENDPOINT=

# 本地数据目录
AGENT_DATA_DIR=data

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
