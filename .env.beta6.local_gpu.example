# CivitasOS Beta-6 local GPU Agent API intake example.
# Copy to .env.beta6.external2.local for local GPU provider diversity tests.
# Do not commit filled local files.

# Distinct provider label for local Ollama.
BETA6_EXTERNAL_AGENT_PROVIDER=local_ollama_gpu

# OpenAI-compatible intake remains available for generic model calls.
BETA6_EXTERNAL_AGENT_API_BASE_URL=http://127.0.0.1:11434/v1
BETA6_EXTERNAL_AGENT_MODEL=qwen3.6:latest
BETA6_EXTERNAL_AGENT_ALLOW_LOCAL_HTTP=true

# Local-only token placeholder. Ollama usually ignores bearer auth, but the
# Beta-6 intake requires a non-empty key so the credential path stays uniform.
BETA6_EXTERNAL_AGENT_API_KEY=local-ollama-loopback-token

# FE-13/FE-7 reviewer commands should use the Ollama-native runner so thinking
# is disabled and JSON output is schema-checked:
#
#   --runner-spec 'local-gpu-agent=ollama-native:qwen3.6:latest'
#   --additional-reviewer-spec 'local-gpu-agent=ollama-native:qwen3.6:latest'
#
# Optional native endpoint override:
CIVITASOS_OLLAMA_NATIVE_URL=http://127.0.0.1:11434
