# CivitasOS Beta-0 real-model controlled pilot example.
# Copy values into your local shell or private .env file. Do not commit secrets.

# Backend must already be running and configured with the same secrets.
BACKEND_URL=http://localhost:8099
CIVITASOS_URL=http://localhost:8099

# External model. Use any provider supported by civitasos-runtime:
# - openai:<model>
# - anthropic:<model>
# - litellm:<provider/model>
# DeepSeek OpenAI-compatible example:
#   AGENT_LLM=openai:deepseek-v4-flash
#   LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM=openai:REPLACE_WITH_REAL_MODEL
LLM_BASE_URL=
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY

# Strict L1 auth and event-wake boundary.
CIVITASOS_SERVICE_TOKEN_SECRET=REPLACE_WITH_LONG_LOCAL_SECRET
CIVITASOS_WAKE_CALLBACK_SECRET=REPLACE_WITH_LONG_LOCAL_SECRET
CIVITASOS_A2A_ALLOW_PRIVATE_CALLBACKS=true
L1_PILOT_001_SERVICE_SCOPES=agents:read,agents:write,pool:post,pool:read,pool:claim,pool:write,webhooks:write

# Beta-0 must use an external model by default.
BETA0_REQUIRE_EXTERNAL_MODEL=1
BETA0_RUN_PACKET_CHECK=auto

# Optional run root override.
# BETA0_RUN_ROOT=runs/beta0_real_model_pilot_manual
